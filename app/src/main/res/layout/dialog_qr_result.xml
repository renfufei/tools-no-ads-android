<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp">

    <!-- Read-only but selectable: user can long-press to select and copy -->
    <TextView
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="6"
        android:maxLines="12"
        android:scrollbars="vertical"
        android:gravity="top"
        android:textIsSelectable="true"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:background="@drawable/qr_result_text_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_copy_all"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/qr_copy_all"
            android:textSize="14sp"
            app:cornerRadius="0dp" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_open_browser"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/qr_open_browser"
            android:textSize="14sp"
            android:visibility="gone"
            app:cornerRadius="0dp" />
    </LinearLayout>

</LinearLayout>
